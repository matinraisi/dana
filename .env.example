# =============================================================================
# Dana — customer instance environment (copy to .env and fill in)
# Secrets and infrastructure ONLY. Product identity: install_config.py
# =============================================================================

# REQUIRED — Django secret (generate a unique value per customer; never commit real secrets)
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=False

# Initial password for newly created teacher/student accounts (Academy). Change in production.
DEFAULT_INITIAL_PASSWORD=ChangeMeNow!

# REQUIRED — this instance's database (never share with another customer)
DATABASE_URL=sqlite:///db.sqlite3
# Example MySQL:
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/CUSTOMER_DB_NAME

# REQUIRED — this customer's public host(s) and CSRF origins (replace with real domain)
ALLOWED_HOSTS=customer.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://customer.example.com

# Paths on the server (adjust per host; Docker often overrides these)
STATIC_ROOT=/var/www/customer/static/
MEDIA_ROOT=/var/www/customer/media/

# --- SMS (optional until customer needs messaging) ---
IPPANEL_API_TOKEN=
IPPANEL_SENDER=
SMS_ADMIN_PHONES=

# --- Payments (Academy; optional until online pay is enabled) ---
PAYMENT_CALLBACK_URL=https://customer.example.com/dashboard/payment/callback/
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_CLIENT_ID=
PAYMENT_GATEWAY_SECRET=
PANEL_PUBLIC_URL=https://customer.example.com

JITSI_DOMAIN=meet.jit.si
