SECRET_KEY=your-secret-key-here
DEBUG=False
# academy: نصب عملیاتی آموزشگاه | school: نصب عملیاتی مدرسه |
# control: سایت مرکزی دانا، بدون داده عملیاتی مشتریان
PRODUCT_MODE=academy
IPPANEL_API_TOKEN=your-ippanel-api-token
IPPANEL_SENDER=+98...
SMS_ADMIN_PHONES=+989...

# هاست cPanel
ALLOWED_HOSTS=panel.aihousesb.ir,aihousesb.ir,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://panel.aihousesb.ir,https://aihousesb.ir
STATIC_ROOT=/home/bahuloun/panel.aihousesb.ir/static/
MEDIA_ROOT=/home/bahuloun/panel.aihousesb.ir/media/

# درگاه پرداخت — callback از دامنه اصلی
PAYMENT_CALLBACK_URL=https://aihousesb.ir/dashboard/payment/callback/

# درگاه پرداخت سان‌تک — اگر پر باشد پرداخت‌ها از درگاه ساخته می‌شوند.
# SECRET همان secret کلاینت aihouse-panel در /srv/payment-gateway/gateway.env است.
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_CLIENT_ID=aihouse-panel
PAYMENT_GATEWAY_SECRET=
PANEL_PUBLIC_URL=https://panel.aihousesb.ir

# کلاس آنلاین
JITSI_DOMAIN=meet.jit.si
PRODUCT_MODE=school
DATABASE_URL=sqlite:///D:/project/AAA/panel.aihousesb.ir/school-test.sqlite3